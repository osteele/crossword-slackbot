{
  "name": "crossword-slackbot",
  "version": "1.0.0",
  "description": "Automatically adds date separator messages to the #crossword Slack channel",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check": "biome format . && biome lint . && vitest run",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.8",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.12.0",
    "minimist": "^1.2.8"
  }
}
